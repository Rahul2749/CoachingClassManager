server {
    listen 80;
    server_name staging.your-domain.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name staging.your-domain.example;
    ssl_certificate /etc/letsencrypt/live/staging.your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.your-domain.example/privkey.pem;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:5081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
